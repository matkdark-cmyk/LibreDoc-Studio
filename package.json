{
  "name": "libredoc-studio",
  "productName": "LibreDoc Studio",
  "private": true,
  "version": "0.2.2",
  "description": "Aplicación de escritorio nativa para Windows orientada a analizar, desbloquear, extraer campos con OCR local y editar documentos conservando el diseño original.",
  "repository": {
    "type": "git",
    "url": "https://github.com/matkdark-cmyk/LibreDoc-Studio.git"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "vite build && npm run build:electron",
    "electron:dev": "concurrently -k -n VITE,ELECTRON \"vite --port=3000 --host=127.0.0.1\" \"wait-on http://127.0.0.1:3000 && npm run build:electron && cross-env NODE_ENV=development ELECTRON_DEV_URL=http://127.0.0.1:3000 electron .\"",
    "electron:build": "npm run build",
    "setup:qpdf": "node scripts/download-qpdf-win.mjs",
    "setup:tessdata": "node scripts/download-tessdata.mjs",
    "setup:assets": "npm run setup:qpdf && npm run setup:tessdata",
    "rebuild:native": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:win:publish": "npm run build && electron-builder --win nsis --x64 --publish always",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release server.js",
    "lint": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.12.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  }
}
